{
  "name": "medguide-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo start --localhost --android",
    "ios": "expo start --localhost --ios",
    "web": "expo start --localhost --web",
    "lint": "node node_modules/eslint-10/bin/eslint.js . --ext .js,.ts,.tsx",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:security": "node --test scripts/toolchain-security.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-notifications": "~58.1.5",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@eslint/compat": "^2.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "braces": "file:vendor/braces",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "node-forge": "file:vendor/node-forge",
    "sprintf-js": "file:vendor/sprintf-js",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "eslint-10": "npm:eslint@^10.13.0",
    "eslint-import-resolver-typescript": "^3.10.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 78,
        "branches": 65,
        "functions": 75,
        "lines": 80
      }
    },
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1",
    "braces": "$braces",
    "node-forge": "$node-forge",
    "sprintf-js": "$sprintf-js"
  }
}
