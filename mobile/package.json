{
  "name": "medguide-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo start --localhost --android",
    "ios": "expo start --localhost --ios",
    "web": "expo start --localhost --web",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:security": "node --test scripts/toolchain-security.test.cjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "braces": "file:vendor/braces",
    "node-forge": "file:vendor/node-forge",
    "sprintf-js": "file:vendor/sprintf-js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 78,
        "branches": 65,
        "functions": 75,
        "lines": 80
      }
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "braces": "$braces",
    "node-forge": "$node-forge",
    "sprintf-js": "$sprintf-js"
  }
}
