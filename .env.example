# MedGuide AI example configuration.
# Copy to .env for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# Environment overview
# ---------------------------------------------------------------------------
APP_NAME=MedGuide AI API
APP_ENV=local
EXPO_PUBLIC_APP_ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
READINESS_TIMEOUT_SECONDS=2

# CORS. Current backend reads API_CORS_ORIGINS; CORS_ALLOWED_ORIGINS is the
# deployment-facing alias documented in docs/PLACEHOLDERS_AND_SECRETS.md.
API_CORS_ORIGINS=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Current backend reads JWT_SECRET. JWT_SECRET_KEY is kept as the documented
# deployment alias; keep both aligned until code-level alias support is added.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Medication timing and verification windows
# ---------------------------------------------------------------------------
DOSE_ON_TIME_WINDOW_MINUTES=30
VERIFICATION_DUE_EARLY_MINUTES=30
VERIFICATION_RECENT_DUE_MINUTES=120

# ---------------------------------------------------------------------------
# Reminder lifecycle and retry policy
# ---------------------------------------------------------------------------
REMINDER_SECOND_OFFSET_MINUTES=15
REMINDER_ESCALATION_MINUTES=30
REMINDER_MISSED_CUTOFF_MINUTES=60
NOTIFICATION_RETRY_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Notification providers
# ---------------------------------------------------------------------------
NOTIFICATION_PROVIDER=unconfigured
EXPO_PUSH_ACCESS_TOKEN=
EXPO_ACCESS_TOKEN=

SMS_PROVIDER=disabled
EMAIL_PROVIDER=disabled
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_CAREGIVER_ESCALATION=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Caregiver invites
# ---------------------------------------------------------------------------
CAREGIVER_INVITE_EXPIRE_HOURS=72
CAREGIVER_INVITE_TOKEN_RETURN_ENABLED=false

# ---------------------------------------------------------------------------
# Private image storage
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=unconfigured
STORAGE_SIGNED_URL_EXPIRE_SECONDS=300
SIGNED_URL_EXPIRATION_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_SIZE_MB=10
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp
STORAGE_RETENTION_DAYS=

S3_BUCKET=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
ENABLE_LOCAL_DEV_STORAGE=false

# ---------------------------------------------------------------------------
# OCR label scanning
# ---------------------------------------------------------------------------
OCR_PROVIDER=unconfigured
GOOGLE_APPLICATION_CREDENTIALS=
AWS_TEXTRACT_REGION=
AWS_TEXTRACT_ACCESS_KEY_ID=
AWS_TEXTRACT_SECRET_ACCESS_KEY=
IMAGE_QUALITY_MIN_WIDTH=640
IMAGE_QUALITY_MIN_HEIGHT=480
IMAGE_QUALITY_MIN_CONTRAST=20

# ---------------------------------------------------------------------------
# Medication verification vision
# ---------------------------------------------------------------------------
VISION_PROVIDER=unconfigured
AWS_REKOGNITION_REGION=
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
VISION_MODEL_NAME=
ENABLE_AI_VERIFICATION=true

# ---------------------------------------------------------------------------
# Test-only mock switch. Production code must not use this to install mocks.
# ---------------------------------------------------------------------------
ENABLE_TEST_PROVIDER_MOCKS=false

# ---------------------------------------------------------------------------
# Local infrastructure. Replace these with managed-service URLs in production.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://medguide:change-me@localhost:5432/medguide
REDIS_URL=redis://localhost:6379/0
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10

# Docker Compose-only credentials. Use strong, secret-managed values outside
# local development.
POSTGRES_DB=medguide
POSTGRES_USER=medguide
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Mobile public configuration. Never put secrets in EXPO_PUBLIC_* variables.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_LOCAL_REMINDERS=true
EXPO_PUBLIC_ENABLE_AI_VERIFICATION=true
EXPO_PUBLIC_ENABLE_CAREGIVER_DASHBOARD=true
